PORT=8000
MONGODB_URI=mongodb://localhost:27017
# Comma-separated list of allowed client origins (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# Production only. NODE_ENV=production defaults cookies to SameSite=None.
# Use COOKIE_SAMESITE=lax + COOKIE_DOMAIN=.yourdomain.com if client/API share a site.
NODE_ENV=development
COOKIE_SAMESITE=
COOKIE_DOMAIN=

ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
